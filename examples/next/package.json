{
  "name": "evalkeeper-example-next",
  "private": true,
  "type": "module",
  "description": "Evalkeeper in a Next.js app: two example suites, demo models that need no API keys, and the admin pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "setup": "prisma db push --skip-generate && npm run generate && tsx prisma/seed.ts",
    "generate": "prisma generate >/dev/null && prisma generate --schema test/byo/schema.prisma >/dev/null",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "DATABASE_URL=file:./test.db prisma db push --skip-generate >/dev/null && BYO_DATABASE_URL=file:./byo.db prisma db push --schema test/byo/schema.prisma >/dev/null && vitest run",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/openai": "^4.0.103",
    "@ai-sdk/typesafe-ai": "^3.0.30",
    "@crowandraven/evalkeeper": "0.13.0",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.157",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "schema": "prisma"
  }
}
