{
  "name": "evalkeeper-example-next",
  "private": true,
  "type": "module",
  "description": "Evalkeeper in a Next.js app: two example suites, demo models that need no API keys, and the admin pages.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "setup": "prisma db push --skip-generate && prisma generate && tsx prisma/seed.ts",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "test": "DATABASE_URL=file:./test.db prisma db push --skip-generate >/dev/null && vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.129",
    "@ai-sdk/openai": "^3.0.125",
    "@evalkeeper/ai-sdk": "0.1.0",
    "@evalkeeper/prisma": "0.1.0",
    "@prisma/client": "^6.19.3",
    "ai": "^6.0.303",
    "evalkeeper": "0.1.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
