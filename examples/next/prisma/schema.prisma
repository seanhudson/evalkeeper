// The example's own table: DemoAnswer, for the "Rate an answer" page.
// Evalkeeper's tables are in evalkeeper.prisma beside this file, written
// by `npx @crowandraven/evalkeeper migration`; package.json points Prisma
// at this folder so it reads both.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// An answer the "try it" page showed, kept so a rating can point at it.
/// Your app has its own record of what its AI wrote (a message, a summary).
model DemoAnswer {
  id        String   @id @default(uuid())
  operation String
  input     Json
  output    Json
  /// The person agreed to keep this input to improve the feature.
  consented Boolean  @default(false)
  createdAt DateTime @default(now())
}

