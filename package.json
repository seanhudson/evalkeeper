{
  "name": "evalkeeper-monorepo",
  "private": true,
  "description": "Evals for the AI features in your app: answer keys people confirm, tests per model, and model choices on evidence.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/prisma -w packages/ai-sdk",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scrub": "node scripts/scrub-check.mjs",
    "format": "prettier --write .",
    "check": "npm run scrub && npm run format:check && npm run build && npm run typecheck && npm run lint && npm test && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "test:unit": "npm run test -w packages/core",
    "docs:api": "npm run build && typedoc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhudson/evalkeeper.git"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && node scripts/scrub-check.mjs",
    "pre-push": "npm run build && npm run typecheck && npm run test:unit"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
