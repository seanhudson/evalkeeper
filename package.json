{
  "name": "evalkeeper-monorepo",
  "private": true,
  "description": "Evals for the AI features in your app: answer keys people confirm, tests per model, and model choices on evidence.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/prisma -w packages/ai-sdk",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scrub": "node scripts/scrub-check.mjs",
    "format": "prettier --write .",
    "check": "npm run scrub && npm run format:check && npm run build && npm run typecheck && npm run lint && npm test",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhudson/evalkeeper.git"
  }
}
