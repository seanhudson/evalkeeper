{
  "name": "@evalkeeper/ai-sdk",
  "version": "0.1.0",
  "description": "Evalkeeper for the Vercel AI SDK: instruction hashes, call pricing, and a cached meaning judge.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "evalkeeper": "0.1.0"
  },
  "peerDependencies": {
    "ai": ">=5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "ai": "^6.0.303",
    "zod": "^3.25.76"
  },
  "author": "Sean Hudson",
  "homepage": "https://github.com/seanhudson/evalkeeper#readme",
  "bugs": {
    "url": "https://github.com/seanhudson/evalkeeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhudson/evalkeeper.git",
    "directory": "packages/ai-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
