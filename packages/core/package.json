{
  "name": "@crowandraven/evalkeeper",
  "version": "0.13.0",
  "description": "An open-source eval harness for TypeScript apps: test each AI feature against answers people confirm, compare models on accuracy, cost, and speed, and choose the live model on evidence.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./memory": {
      "types": "./dist/memoryStore.d.ts",
      "default": "./dist/memoryStore.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./suites": {
      "types": "./dist/suites/index.d.ts",
      "default": "./dist/suites/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "default": "./dist/cli/main.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "default": "./dist/prisma/index.js"
    },
    "./prisma/schema": "./schema/evalkeeper.prisma",
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./next/components": {
      "types": "./dist/next/components.d.ts",
      "default": "./dist/next/components.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "bin",
    "templates",
    "starter",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-templates.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "ai": ">=7",
    "lucide-react": ">=0.500.0",
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "vitest": ">=3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai": "^7.0.146",
    "lucide-react": "^1.60.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "evals",
    "llm",
    "ai",
    "testing",
    "model-selection"
  ],
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "author": "Sean Hudson",
  "homepage": "https://seanhudson.github.io/evalkeeper/",
  "bugs": {
    "url": "https://github.com/seanhudson/evalkeeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhudson/evalkeeper.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "evalkeeper": "./bin/evalkeeper.mjs"
  }
}
