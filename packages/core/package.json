{
  "name": "evalkeeper",
  "version": "0.1.0",
  "description": "Pure eval logic: suites, checks, stats, model comparisons, and model suggestions on evidence.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    },
    "./memory": {
      "types": "./dist/memoryStore.d.ts",
      "default": "./dist/memoryStore.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "zod": "^3.25.0",
    "vitest": ">=3"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "keywords": [
    "evals",
    "llm",
    "ai",
    "testing",
    "model-selection"
  ],
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "author": "Sean Hudson",
  "homepage": "https://github.com/seanhudson/evalkeeper#readme",
  "bugs": {
    "url": "https://github.com/seanhudson/evalkeeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhudson/evalkeeper.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
