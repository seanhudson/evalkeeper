{
  "name": "@crowandraven/evalkeeper-prisma",
  "version": "0.1.1",
  "description": "Evalkeeper's tables for Prisma, and a store on your Prisma client.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/evalkeeper.prisma"
  },
  "files": [
    "dist",
    "src",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crowandraven/evalkeeper": "0.1.1"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0"
  },
  "author": "Sean Hudson",
  "homepage": "https://github.com/seanhudson/evalkeeper#readme",
  "bugs": {
    "url": "https://github.com/seanhudson/evalkeeper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanhudson/evalkeeper.git",
    "directory": "packages/prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
