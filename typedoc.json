{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Evalkeeper",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/core/src/runner.ts",
    "packages/core/src/memoryStore.ts",
    "packages/core/src/testing.ts",
    "packages/core/src/suites/index.ts",
    "packages/core/src/cli/main.ts",
    "packages/core/src/prisma/index.ts",
    "packages/core/src/ai-sdk/index.ts",
    "packages/core/src/react/index.ts",
    "packages/core/src/next/index.ts",
    "packages/core/src/next/components.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs/api",
  "readme": "docs/api-home.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": ["kind", "alphabetical"],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "packagesRequiringDocumentation": ["evalkeeper-monorepo"]
}
